# Copie este arquivo para `.env` e preencha com os valores reais.
# Nunca commite o `.env` (já está no .gitignore).

# --- Banco de dados (Supabase > Project Settings > Database > Connection string) ---
# Use o "Session pooler" (porta 5432 no host do pooler, não o host direto).
# Ele suporta prepared statements, então funciona tanto para a aplicação
# em runtime (evita esgotar conexões em serverless) quanto para o Prisma
# CLI rodar migrations — só uma URL para os dois casos.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Nunca exponha esta ao cliente — só em código server-side (Storage admin,
# Server Actions).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mercado Pago (Suas integrações > credenciais de teste) ---
# Diferente da API de Payments clássica (que usa prefixo TEST-), as
# credenciais de teste da API de Orders começam com APP_USR- mesmo — é o
# formato correto, não é engano nem credencial de produção.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxx"
# A sandbox da API de Orders só reconhece cartões de teste se o comprador
# for exatamente o e-mail "test@testuser.com" (exigência documentada da
# própria Mercado Pago, não uma escolha nossa). Enquanto "true", o backend
# substitui o e-mail real do usuário por esse ao criar o pedido na Mercado
# Pago — desliga (remova ou defina "false") ao trocar para credenciais de
# produção com clientes de verdade.
MERCADOPAGO_TEST_MODE="true"
# Gerado ao configurar a URL de notificação em Suas integrações > Webhooks.
# Só existe depois que essa URL for uma de verdade (pública) — em dev local
# só dá pra ter isso usando um túnel (ex: ngrok) apontando pro seu localhost.
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública da aplicação, usada para montar a URL de notificação do
# webhook enviada em cada pagamento. Em produção, a URL real do domínio.
# Em dev local, só é alcançável pela Mercado Pago através de um túnel (ex:
# ngrok) — sem isso, o botão de pagamento funciona normalmente, só o
# webhook não chega.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp (categoria "Personalizado") ---
# Só números, com código do país + DDD, sem espaços/traços (ex: 5511999999999).
# Enquanto vazio, o botão de contato fica desativado na página.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
