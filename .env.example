# Copie este arquivo para `.env` e preencha com os valores reais.
# Nunca commite o `.env` (já está no .gitignore).

# --- Banco de dados (Supabase > Project Settings > Database > Connection string) ---
# Use o "Session pooler" (porta 5432 no host do pooler, não o host direto).
# Ele suporta prepared statements, então funciona tanto para a aplicação
# em runtime (evita esgotar conexões em serverless) quanto para o Prisma
# CLI rodar migrations — só uma URL para os dois casos.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Nunca exponha esta ao cliente — só em código server-side (Storage admin,
# Server Actions).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mercado Pago (Suas integrações > credenciais de teste) ---
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxx"
